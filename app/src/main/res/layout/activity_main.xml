<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/mainRoot"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#0B1020"

    android:fillViewport="true"
    android:clipToPadding="false"
    android:overScrollMode="never">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingTop="30dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">


        <!-- ================= HEADER ================= -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_vertical"
            android:minHeight="58dp"
            android:orientation="horizontal">


            <LinearLayout

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical">

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="sans-serif-medium"

                    android:text="SAFE SCAN"

                    android:textColor="#F8FAFC"

                    android:textSize="25sp"
                    android:textStyle="bold"

                    android:letterSpacing="0.025" />

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="5dp"

                    android:text="Your payment safety layer"

                    android:tag="secondary"

                    android:textColor="#7F89A6"

                    android:textSize="12sp" />

            </LinearLayout>


            <!-- THEME -->

            <androidx.appcompat.widget.SwitchCompat

                android:id="@+id/themeToggle"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginEnd="8dp"

                android:text="Light"

                android:textColor="#F8FAFC"
                android:textSize="11sp"

                android:checked="false"

                app:thumbTint="#F8FAFC"
                app:trackTint="#7C5CFC" />


            <!-- SECURITY -->

            <androidx.cardview.widget.CardView

                android:id="@+id/securityBadge"

                android:layout_width="46dp"
                android:layout_height="46dp"

                android:clickable="true"
                android:focusable="true"

                app:cardBackgroundColor="#151C32"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center"

                    android:text="✓"

                    android:tag="green"

                    android:textColor="#22D3A3"

                    android:textSize="20sp"
                    android:textStyle="bold" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>


        <!-- ================= PAYMENT CARD ================= -->

        <androidx.cardview.widget.CardView

            android:id="@+id/paymentCard"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:clickable="true"
            android:focusable="true"

            app:cardBackgroundColor="#292348"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp">

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:minHeight="205dp"

                android:gravity="center_vertical"

                android:orientation="vertical"

                android:padding="23dp">


                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:gravity="center_vertical">

                    <TextView

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:text="READY TO PAY"

                        android:tag="accent"

                        android:textColor="#B8B0FF"

                        android:textSize="10sp"
                        android:textStyle="bold"

                        android:letterSpacing="0.12" />

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:background="#3A3265"

                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"

                        android:text="SECURE"

                        android:tag="accent"

                        android:textColor="#D8D2FF"

                        android:textSize="9sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:fontFamily="sans-serif-medium"

                    android:text="₹1,499"

                    android:tag="white"

                    android:textColor="#FFFFFF"

                    android:textSize="35sp"
                    android:textStyle="bold" />


                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="2dp"

                    android:text="Payment amount"

                    android:tag="accent"

                    android:textColor="#B8B0FF"

                    android:textSize="12sp" />


                <Button

                    android:id="@+id/payButton"

                    android:layout_width="match_parent"
                    android:layout_height="52dp"

                    android:layout_marginTop="19dp"

                    android:backgroundTint="#7C5CFC"

                    android:fontFamily="sans-serif-medium"

                    android:text="Pay Securely  →"

                    android:tag="button"

                    android:textAllCaps="false"

                    android:textColor="#FFFFFF"

                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================= QUICK PAY ================= -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="27dp"

            android:gravity="center_vertical">

            <TextView

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="QUICK PAY"

                android:textColor="#F8FAFC"

                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Choose a method"

                android:tag="muted"

                android:textColor="#65708D"

                android:textSize="10sp" />

        </LinearLayout>


        <!-- ================= QR + UPI ================= -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:orientation="horizontal">


            <!-- QR -->

            <androidx.cardview.widget.CardView

                android:id="@+id/scanQrCard"

                android:layout_width="0dp"
                android:layout_height="120dp"

                android:layout_marginEnd="7dp"

                android:layout_weight="1"

                android:clickable="true"
                android:focusable="true"

                app:cardBackgroundColor="#151C32"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center_vertical"

                    android:orientation="vertical"

                    android:padding="17dp">

                    <TextView

                        android:id="@+id/qrIcon"

                        android:layout_width="43dp"
                        android:layout_height="43dp"

                        android:background="#292348"

                        android:gravity="center"

                        android:text="▣"

                        android:tag="accent"

                        android:textColor="#A78BFA"

                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="9dp"

                        android:text="Scan QR"

                        android:textColor="#F8FAFC"

                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:text="Scan and verify"

                        android:tag="muted"

                        android:textColor="#69748F"

                        android:textSize="10sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- UPI -->

            <androidx.cardview.widget.CardView

                android:id="@+id/manualPaymentCard"

                android:layout_width="0dp"
                android:layout_height="120dp"

                android:layout_marginStart="7dp"

                android:layout_weight="1"

                android:clickable="true"
                android:focusable="true"

                app:cardBackgroundColor="#151C32"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center_vertical"

                    android:orientation="vertical"

                    android:padding="17dp">

                    <TextView

                        android:id="@+id/upiIcon"

                        android:layout_width="43dp"
                        android:layout_height="43dp"

                        android:background="#18213A"

                        android:gravity="center"

                        android:text="↗"

                        android:tag="accent"

                        android:textColor="#818CF8"

                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="9dp"

                        android:text="Enter UPI"

                        android:textColor="#F8FAFC"

                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:text="UPI / Mobile"

                        android:tag="muted"

                        android:textColor="#69748F"

                        android:textSize="10sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>


        <!-- ================= PROTECTION ================= -->

        <androidx.cardview.widget.CardView

            android:id="@+id/protectionCard"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="21dp"

            app:cardBackgroundColor="#111A2D"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp">

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:minHeight="76dp"

                android:gravity="center_vertical"

                android:orientation="horizontal"

                android:padding="16dp">

                <TextView

                    android:id="@+id/protectionIcon"

                    android:layout_width="43dp"
                    android:layout_height="43dp"

                    android:background="#12372F"

                    android:gravity="center"

                    android:text="✓"

                    android:tag="green"

                    android:textColor="#22D3A3"

                    android:textSize="19sp"
                    android:textStyle="bold" />

                <LinearLayout

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="12dp"

                    android:layout_weight="1"

                    android:orientation="vertical">

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Payment Protection"

                        android:textColor="#F8FAFC"

                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:text="Receiver verification is ready"

                        android:tag="secondary"

                        android:textColor="#71809E"

                        android:textSize="10sp" />

                </LinearLayout>

                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="ACTIVE"

                    android:tag="green"

                    android:textColor="#22D3A3"

                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================= TOOLS ================= -->

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="25dp"

            android:text="TOOLS"

            android:textColor="#F8FAFC"

            android:textSize="15sp"
            android:textStyle="bold" />


        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="11dp"

            android:orientation="horizontal">


            <!-- CHECK UPI -->

            <androidx.cardview.widget.CardView

                android:id="@+id/checkUpiCard"

                android:layout_width="0dp"
                android:layout_height="78dp"

                android:layout_marginEnd="7dp"

                android:layout_weight="1"

                android:clickable="true"
                android:focusable="true"

                app:cardBackgroundColor="#151C32"
                app:cardCornerRadius="19dp"
                app:cardElevation="0dp">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center_vertical"

                    android:orientation="horizontal"

                    android:padding="13dp">

                    <TextView

                        android:id="@+id/checkUpiIcon"

                        android:layout_width="37dp"
                        android:layout_height="37dp"

                        android:background="#12372F"

                        android:gravity="center"

                        android:text="⌕"

                        android:tag="green"

                        android:textColor="#22D3A3"

                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="10dp"

                        android:text="Check UPI"

                        android:textColor="#E8EAF1"

                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- PAYMENT INFO -->

            <androidx.cardview.widget.CardView

                android:id="@+id/paymentInfoCard"

                android:layout_width="0dp"
                android:layout_height="78dp"

                android:layout_marginStart="7dp"

                android:layout_weight="1"

                android:clickable="true"
                android:focusable="true"

                app:cardBackgroundColor="#151C32"
                app:cardCornerRadius="19dp"
                app:cardElevation="0dp">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:gravity="center_vertical"

                    android:orientation="horizontal"

                    android:padding="13dp">

                    <TextView

                        android:id="@+id/paymentInfoIcon"

                        android:layout_width="37dp"
                        android:layout_height="37dp"

                        android:background="#292348"

                        android:gravity="center"

                        android:text="▤"

                        android:tag="accent"

                        android:textColor="#A78BFA"

                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="10dp"

                        android:text="Payment Info"

                        android:textColor="#E8EAF1"

                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>


        <!-- ================= BOTTOM NAV ================= -->

        <androidx.cardview.widget.CardView

            android:id="@+id/bottomNav"

            android:layout_width="match_parent"
            android:layout_height="64dp"

            android:layout_marginTop="24dp"

            app:cardBackgroundColor="#151C32"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp">

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center"

                android:orientation="horizontal">


                <TextView

                    android:id="@+id/homeNav"

                    android:layout_width="0dp"
                    android:layout_height="match_parent"

                    android:layout_weight="1"

                    android:gravity="center"

                    android:text="⌂&#10;Home"

                    android:tag="accent"

                    android:textColor="#A78BFA"

                    android:textSize="10sp"
                    android:textStyle="bold" />


                <TextView

                    android:id="@+id/historyNav"

                    android:layout_width="0dp"
                    android:layout_height="match_parent"

                    android:layout_weight="1"

                    android:gravity="center"

                    android:text="▤&#10;History"

                    android:tag="muted"

                    android:textColor="#69748F"

                    android:textSize="10sp" />


                <TextView

                    android:id="@+id/securityNav"

                    android:layout_width="0dp"
                    android:layout_height="match_parent"

                    android:layout_weight="1"

                    android:gravity="center"

                    android:text="♢&#10;Security"

                    android:tag="muted"

                    android:textColor="#69748F"

                    android:textSize="10sp" />


                <TextView

                    android:id="@+id/settingsNav"

                    android:layout_width="0dp"
                    android:layout_height="match_parent"

                    android:layout_weight="1"

                    android:gravity="center"

                    android:text="⚙&#10;Settings"

                    android:tag="muted"

                    android:textColor="#69748F"

                    android:textSize="10sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
