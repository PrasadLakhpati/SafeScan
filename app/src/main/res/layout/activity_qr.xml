<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1020">

    <!-- CAMERA PREVIEW -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        app:scaleType="fillCenter" />

    <!-- DARK OVERLAY -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#550B1020" />

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="35dp"
        android:paddingEnd="20dp"
        android:paddingBottom="15dp">

        <!-- BACK BUTTON -->
        <androidx.cardview.widget.CardView
            android:id="@+id/backButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#CC151C32"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

        </androidx.cardview.widget.CardView>

        <!-- TITLE AND STATUS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCAN QR"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scanStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Starting camera..."
                android:textColor="#A78BFA"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- FLASH BUTTON -->
        <androidx.cardview.widget.CardView
            android:id="@+id/flashButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#CC151C32"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⚡"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- QR SCANNING FRAME -->
    <FrameLayout
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center">

        <!-- TRANSPARENT FRAME BACKGROUND -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- PURPLE BORDER: TOP -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:background="#7C5CFC" />

        <!-- PURPLE BORDER: BOTTOM -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:background="#7C5CFC" />

        <!-- PURPLE BORDER: LEFT -->
        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="#7C5CFC" />

        <!-- PURPLE BORDER: RIGHT -->
        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#7C5CFC" />

        <!-- CENTER INSTRUCTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#990B1020"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="Place QR inside frame"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

    </FrameLayout>

    <!-- BOTTOM PANEL -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#F2151C32"
        app:cardCornerRadius="25dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- SECURITY STATUS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/securityStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="●  Preparing camera"
                    android:textColor="#22D3A3"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAFE SCAN"
                    android:textColor="#7C5CFC"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- SCAN HINT -->
            <TextView
                android:id="@+id/scanHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Point your camera at a payment QR code"
                android:textColor="#A7AEC4"
                android:textSize="12sp" />

            <!-- MANUAL UPI BUTTON -->
            <TextView
                android:id="@+id/manualUpiButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="15dp"
                android:background="#292348"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Enter UPI manually"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
