<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/upiRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1020"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="←  Back"
                android:tag="accent"
                android:textColor="#C4B5FD"
                android:textSize="16sp" />

             <!-- Theme Toggle (Matching MainActivity style but simplified for space if needed) -->
             <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

             <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/themeToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Light"
                android:textColor="#F8FAFC"
                android:textSize="11sp"
                android:checked="false"
                app:thumbTint="#F8FAFC"
                app:trackTint="#7C5CFC" />
        </LinearLayout>


        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Find Receiver"
            android:tag="primary"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Verify before you pay"
            android:tag="secondary"
            android:textColor="#9CA3B8"
            android:textSize="15sp" />

        <!-- Search Bar -->
        <LinearLayout
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#151C32"
            android:orientation="horizontal"
            android:padding="4dp">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search phone number or UPI ID"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:tag="primary"
                android:textColor="#FFFFFF"
                android:textColorHint="#69748F"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/searchProgress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                android:indeterminateTint="#7C5CFC"/>

            <Button
                android:id="@+id/searchButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#7C5CFC"
                android:text="Search"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/searchErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp"
            android:text="Invalid UPI ID or phone number."
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Result Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:cardBackgroundColor="#171D32"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/resultStatusTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#12372F"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="VERIFIED"
                    android:textColor="#22D3A3"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resultName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Receiver Name"
                    android:tag="primary"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resultUpiId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="upi_id@bank"
                    android:tag="secondary"
                    android:textColor="#B8BBD0"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/resultPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="+91 9876543210"
                    android:tag="secondary"
                    android:textColor="#B8BBD0"
                    android:textSize="14sp"
                    android:visibility="gone"/>

                <View
                    android:id="@+id/resultDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="#292348" />

                <TextView
                    android:id="@+id/resultSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Source: Neon Database"
                    android:tag="muted"
                    android:textColor="#69748F"
                    android:textSize="12sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <!-- Safety Information -->
        <LinearLayout
            android:id="@+id/safetyInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#202039"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛡  About SafeScan"
                android:tag="primary"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="SafeScan cross-references payment details with our secure database and external verification services. A verified badge indicates the recipient's identity has been confirmed."
                android:tag="secondary"
                android:textColor="#B8BBD0"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Action Button -->
        <Button
            android:id="@+id/safeScanButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#292348"
            android:text="Review Payment"
            android:textAllCaps="false"
            android:textColor="#7F89A6"
            android:textSize="16sp"
            android:textStyle="bold"
            android:enabled="false" />

    </LinearLayout>
</ScrollView>